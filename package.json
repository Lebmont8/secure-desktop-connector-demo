{
  "name": "secure-desktop-connector-demo",
  "version": "0.1.0",
  "private": true,
  "productName": "Secure Desktop Connector Demo",
  "description": "Mock-only secure Electron connector with OS-keychain protection and signed device control plane",
  "main": "desktop-connector/dist/main.cjs",
  "scripts": {
    "build": "node desktop-connector/scripts/build.mjs",
    "demo-server": "npm run build && node desktop-connector/dist/demo-server.cjs",
    "desktop": "npm run build && electron-forge start",
    "package:desktop": "npm run build && electron-forge package",
    "make:desktop": "npm run build && electron-forge make",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@electron-forge/cli": "8.0.0-alpha.10",
    "@electron-forge/maker-deb": "8.0.0-alpha.10",
    "@electron-forge/maker-squirrel": "8.0.0-alpha.10",
    "@electron-forge/maker-zip": "8.0.0-alpha.10",
    "@electron-forge/plugin-fuses": "8.0.0-alpha.10",
    "@electron/fuses": "2.1.3",
    "@types/node": "^22.0.0",
    "electron": "43.2.0",
    "electron-squirrel-startup": "1.0.1",
    "esbuild": "0.28.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=22"
  }
}
